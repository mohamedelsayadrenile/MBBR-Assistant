# .env is the single source of truth for configuration.
# Every key below is required by src/core/config.py — there are no in-code
# defaults, so a missing key raises a validation error at startup.

APP_NAME=MBBR Assistant
APP_ENV=local
LOG_LEVEL=INFO

# One OpenAI-compatible endpoint serves both environments. Development = Qwen
# API; production = self-hosted Qwen on vLLM. Switch by changing these three
# values.
#
# --- development: Qwen API (OpenAI-compatible mode) ---
# Use https://dashscope.aliyuncs.com/compatible-mode/v1 for the mainland-China region.
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-your-qwen-api-key
LLM_MODEL=qwen3.6-35b-a3b

# --- production: self-hosted vLLM ---
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=<your served model id>

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TOP_P=0.8
# vLLM-only extensions. Leave blank on the Qwen API — when unset they are omitted
# from the request entirely, so a hosted endpoint never sees an unknown field.
LLM_TOP_K=
LLM_ENABLE_THINKING=

# supported providers: cohere
ASR_PROVIDER=cohere
ASR_MODEL=CohereLabs/cohere-transcribe-arabic-07-2026
ASR_DEVICE=cuda:0
ASR_DTYPE=float16
ASR_LANGUAGE=ar
ASR_MAX_NEW_TOKENS=256
ASR_MAX_AUDIO_BYTES=5242880

# supported providers: voicetut
TTS_PROVIDER=voicetut
TTS_MODEL=mohammedaly22/VoiceTut-TTS
TTS_DEVICE=cuda:0
TTS_DTYPE=float16
# The voice used when a request does not name one. Any of these, or the cloned
# voice Elsayad, can also be sent per request as the chat endpoint's `voice`
# field -- GET /api/v1/voices lists what this build accepts.
# built-in speakers: Abdelrahman, Abdullah, Kamal, Hossam, Mohamed, Omar, Sayed,
#                    Zaki, Aly, Essam, Ahmed, Asmaa, Esraa, Hanan, Sarah, Yasmin, Omnia
TTS_DEFAULT_VOICE=Asmaa
TTS_NUM_STEP=48
TTS_GUIDANCE_SCALE=2.5
TTS_SPEED=1.05

REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=1800
MEMORY_MAX_MESSAGES=12

MBBR_API_BASE_URL=http://41.32.195.157:8083
DEVICES_API_PATH=/api/devices
CURRENT_READINGS_API_PATH=/api/readings/latest
HTTP_TIMEOUT_SECONDS=30
